VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-side/local sync only. Never prefix these with VITE_ or commit real values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
PORTFOLIO_OWNER_EMAIL=approved-user@example.com
# Prefer the immutable Supabase Auth UUID for automated jobs; email is a fallback resolver only.
PORTFOLIO_OWNER_ID=00000000-0000-0000-0000-000000000000
PORTFOLIO_EVM_ADDRESSES=comma-separated-public-wallet-addresses
BINANCE_KEY_FILE=/absolute/path/to/restricted/binance.env
WIO_CSV_PATHS=/path/old.csv:/path/current.csv
XTB_EXPORT_PATH=/path/to/xtb.zip
WIO_STOCKS_JSON_PATH=/path/to/private-wio-stocks.json
PORTFOLIO_TIME_ZONE=Asia/Kolkata
